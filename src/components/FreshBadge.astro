---
// "Confirmed 3 days ago" — the one freshness tag. Community votes can refresh it in the browser.
import { freshBadge } from '../lib/status';

interface Props {
  slug: string;
  verified?: Date;
}
const { slug, verified } = Astro.props;
const b = freshBadge(verified);
---

<span
  class:list={['pill', 'fresh', b.tone]}
  data-slug={slug}
  data-verified={verified ? verified.toISOString() : ''}
  title="When a local last confirmed the Wi-Fi and outlets"
>
  <span class="dot"></span>
  <span class="fresh-text">{b.text}</span>
</span>

<style>
  .fresh {
    font-size: 0.75rem;
    padding: 2px 9px;
  }
</style>
