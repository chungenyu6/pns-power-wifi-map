---
import { daysAgo, type Freshness } from '../lib/meta';

interface Props {
  freshness: Freshness;
  verified?: Date;
}
const { freshness, verified } = Astro.props;
const cls = { recent: 'good', old: 'warn', unverified: '' }[freshness];
const label = verified ? `Confirmed ${daysAgo(verified)}` : 'Not confirmed yet';
const title = verified
  ? `A local confirmed these details on ${verified.toISOString().slice(0, 10)}`
  : 'From listings and guides; no local has confirmed it yet';
---

<span class:list={['pill', 'fresh', cls]} title={title}>
  <span class="dot"></span>
  {label}
</span>

<style>
  .fresh {
    font-size: 0.75rem;
    padding: 2px 9px;
  }
</style>
