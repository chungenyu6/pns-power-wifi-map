---
// Amenity pills. Rendered from our data; src/scripts/community.ts re-renders them once votes load.
import Icon from './Icon.astro';
import { pill, type Attr } from '../lib/status';
import type { ShopView } from '../lib/shops';

interface Props {
  shop: ShopView;
}
const { shop } = Astro.props;
const items: { attr: Attr; icon: 'wifi' | 'plug' | 'laptop' | 'volume'; value: string }[] = [
  { attr: 'wifi', icon: 'wifi', value: shop.wifi },
  { attr: 'outlets', icon: 'plug', value: shop.outlets },
  { attr: 'laptop', icon: 'laptop', value: shop.laptop },
  { attr: 'noise', icon: 'volume', value: shop.noise },
];
---

<ul class="amenities" aria-label="Amenities" data-slug={shop.slug} data-wifi-free={String(shop.wifiFree)}>
  {
    items.map(({ attr, icon, value }) => {
      const p = pill(attr, value as never, { wifiFree: shop.wifiFree });
      return (
        <li class:list={['pill', p.tone]} data-attr={attr} data-base={value} hidden={p.hidden}>
          <Icon name={icon} />
          <span class="pill-text">{p.text}</span>
        </li>
      );
    })
  }
</ul>

<style>
  .amenities {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
