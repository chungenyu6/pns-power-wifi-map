---
// "Been here recently?" — one-tap votes, optional comment/password, and the feed of approved notes.
import Votes from './Votes.astro';

interface Props {
  slug: string;
}
const { slug } = Astro.props;
---

<section class="report" aria-labelledby="report-h" data-slug={slug}>
  <h2 id="report-h">Been here recently?</h2>
  <p class="muted lead">One tap helps the next person. Tap again to take it back. Counts cover the last 30 days.</p>

  <Votes slug={slug} name="this shop" withOpen />

  <form class="report-form" novalidate>
    <p class="form-intro">Know the Wi-Fi password or have a tip? <span class="muted">Shows up after a quick review.</span></p>

    <label class="field">
      <span>Wi-Fi password <em>(optional)</em></span>
      <input name="wifi_password" maxlength="64" autocomplete="off" autocapitalize="off" spellcheck="false" />
    </label>
    <label class="field">
      <span>Anything else? <em>(optional)</em></span>
      <textarea name="comment" rows="3" maxlength="500" placeholder="Outlets along the window bar, no laptops on weekends, packed after 3pm…"></textarea>
    </label>
    <!-- Bots fill every field; people never see this one. -->
    <label class="hp" aria-hidden="true">Website <input name="website" tabindex="-1" autocomplete="off" /></label>

    <div class="actions">
      <button class="btn" type="submit">Send</button>
      <p class="form-msg" role="status" aria-live="polite"></p>
    </div>
  </form>

  <div class="feed">
    <h3>Tips from locals</h3>
    <ol class="feed-list" aria-live="polite"><li class="muted">Loading…</li></ol>
  </div>
</section>

<script>
  import { describe, reportsForShop, submitReport, timeAgo, type NewReport, type Report } from '../lib/reports';
  import { initVotes } from '../scripts/votes';

  const section = document.querySelector<HTMLElement>('.report[data-slug]')!;
  const slug = section.dataset.slug!;
  const form = section.querySelector<HTMLFormElement>('.report-form')!;
  const msg = section.querySelector<HTMLElement>('.form-msg')!;
  const list = section.querySelector<HTMLOListElement>('.feed-list')!;

  function render(all: Report[]) {
    // Votes are summed up in the buttons above; the feed is for written tips and passwords.
    const reports = all.filter((r) => r.comment || r.wifi_password);
    list.replaceChildren();
    if (reports.length === 0) {
      list.innerHTML = '<li class="muted">No tips yet.</li>';
      return;
    }
    for (const r of reports) {
      const li = document.createElement('li');
      const head = document.createElement('div');
      head.className = 'feed-head';
      const status = document.createElement('strong');
      status.textContent = describe(r) || 'Tip';
      const when = document.createElement('time');
      when.dateTime = r.created_at;
      when.textContent = timeAgo(r.created_at);
      head.append(status, when);
      li.append(head);
      if (r.wifi_password) {
        const p = document.createElement('p');
        p.className = 'pw';
        p.append('Wi-Fi password: ');
        const code = document.createElement('code');
        code.textContent = r.wifi_password;
        p.append(code);
        li.append(p);
      }
      if (r.comment) {
        const p = document.createElement('p');
        p.textContent = r.comment;
        li.append(p);
      }
      list.append(li);
    }
  }

  async function load() {
    try {
      render(await reportsForShop(slug));
    } catch {
      list.innerHTML = '<li class="muted">Reports are not available right now.</li>';
    }
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    if (data.get('website')) return; // honeypot
    const text = (v: FormDataEntryValue | null) => (typeof v === 'string' && v.trim() ? v.trim() : undefined);
    const report: NewReport = {
      shop_slug: slug,
      wifi_password: text(data.get('wifi_password')),
      comment: text(data.get('comment')),
    };
    if (!report.comment && !report.wifi_password) {
      msg.textContent = 'Add a password or a tip first.';
      return;
    }
    const button = form.querySelector('button')!;
    button.disabled = true;
    msg.textContent = 'Sending…';
    try {
      await submitReport(JSON.parse(JSON.stringify(report)));
      msg.textContent = 'Thanks! It will show up after a quick review.';
      form.reset();
    } catch (err) {
      msg.textContent = (err as Error).message;
    } finally {
      button.disabled = false;
    }
  });

  load();
  initVotes();
</script>

<style>
  .report {
    margin-bottom: 36px;
    padding: 22px 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .lead {
    margin-bottom: 18px;
  }


  .report-form {
    margin-top: 24px;
    padding-top: 18px;
    border-top: 1px solid var(--border);
  }

  .form-intro {
    font-weight: 550;
    margin-bottom: 12px;
  }

  .form-intro span {
    font-weight: 400;
  }

  .field {
    display: block;
    margin-bottom: 12px;
  }

  .field span {
    display: block;
    font-weight: 550;
    margin-bottom: 4px;
  }

  .field em {
    font-style: normal;
    font-weight: 400;
    color: var(--muted);
  }

  .field input,
  .field textarea {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg);
    color: var(--text);
    font: inherit;
  }

  .hp {
    position: absolute;
    left: -9999px;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .actions .btn:disabled {
    opacity: 0.6;
  }

  .form-msg {
    margin: 0;
    font-size: 0.9rem;
    color: var(--green);
  }

  .feed {
    margin-top: 26px;
    padding-top: 18px;
    border-top: 1px solid var(--border);
  }

  .feed h3 {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
  }

  .feed-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .feed-list :global(li) {
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.92rem;
  }

  .feed-list :global(li:last-child) {
    border-bottom: 0;
  }

  .feed-list :global(.feed-head) {
    display: flex;
    justify-content: space-between;
    gap: 10px;
  }

  .feed-list :global(time) {
    color: var(--muted);
    white-space: nowrap;
  }

  .feed-list :global(p) {
    margin: 4px 0 0;
  }

  .feed-list :global(code) {
    padding: 1px 6px;
    border-radius: 6px;
    background: var(--surface-2);
    font-size: 0.9em;
  }
</style>
